{
	"schemaVersion": 1,
	"id": "moderngui",
	"version": "${version}",
	"name": "Modern GUI",
	"description": "A widget library for Minecraft mods: dark rounded cards, anti-aliased shapes and a bundled Inter font.",
	"authors": [
		"Fayber"
	],
	"contact": {
		"homepage": "https://github.com/Fayberr/fayber-gui",
		"sources": "https://github.com/Fayberr/fayber-gui"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/moderngui/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.fayber.moderngui.ModernGuiClient"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=26.1 <26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
